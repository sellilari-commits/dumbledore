{
  "name": "dumbledore",
  "version": "0.1.0",
  "private": true,
  "description": "Dumbledore — a study coach that lives on your Mac",
  "main": "out/main/index.js",
  "author": "Ilari",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true; npm run -s electron:fetch || true",
    "dev": "node tools/dev.mjs",
    "dev:app-helper": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "helper:build": "bash native/helper/build.sh",
    "seed": "tsx tools/seed-demo.ts",
    "eval": "tsx tools/eval-prompts.ts",
    "icons": "tsx --tsconfig tsconfig.node.json tools/brand/build-icons.ts",
    "electron:fetch": "node node_modules/electron/install.js",
    "package": "npm run helper:build && npm run build && npm run electron:fetch && electron-builder --mac --dir",
    "install-app": "bash tools/install-app.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.104",
    "@ai-sdk/groq": "^4.0.69",
    "@ai-sdk/mistral": "^4.0.71",
    "@ai-sdk/openai-compatible": "^3.0.77",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.152",
    "better-sqlite3": "^13.0.3",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "wouter": "^3.13.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
