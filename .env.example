# Copy to .env.local (git-ignored). Read at startup in development only;
# the packaged app stores keys in the macOS Keychain via Settings.

# Free key from https://console.groq.com/keys (no card needed). Primary for roadmaps, quizzes, prompts.
GROQ_API_KEY=

# Optional EU fallback. In the Mistral console, turn off "Anonymous improvement data".
MISTRAL_API_KEY=

# OVHcloud AI Endpoints works without a key (2 requests/min per model); a token raises the limit.
OVH_AI_ENDPOINTS_TOKEN=
