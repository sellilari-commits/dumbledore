# Copy to .env.local (git-ignored). Read at startup in development only;
# the packaged app stores keys in the macOS Keychain via Settings.

# Point at existing env files instead of copying keys (comma-separated). Only the variables
# below are imported from them. Default setup on Ilari's Mac: the Hugo backend's paid Gemini key.
DUMBLEDORE_ENV_FILES=/Users/admin/hugo/hugo-backend/.env

# Primary: Gemini 3.5 (paid key → paid-service terms, no training on prompts).
GEMINI_API_KEY=

# Fallbacks. Groq: free key from https://console.groq.com/keys (no card).
GROQ_API_KEY=
# Optional EU fallback. In the Mistral console, turn off "Anonymous improvement data".
MISTRAL_API_KEY=
# OVHcloud AI Endpoints works without a key (2 requests/min per model); a token raises the limit.
OVH_AI_ENDPOINTS_TOKEN=
