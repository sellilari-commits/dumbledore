# Copy to .env.local (git-ignored). Development reads the repo's .env.local; the installed app
# reads ~/Library/Application Support/Dumbledore/.env.local. Keys saved in Settings → AI providers
# (macOS Keychain) work without any file. Only the variables below are read from these files.

# Point at existing env files instead of copying keys (comma-separated); only the key variables
# below are imported from them. E.g. the Hugo backend's paid Gemini key:
# DUMBLEDORE_ENV_FILES=/Users/you/hugo/hugo-backend/.env
DUMBLEDORE_ENV_FILES=

# Primary: Gemini 3.5 (paid key → paid-service terms, no training on prompts).
GEMINI_API_KEY=

# Fallbacks. Groq: free key from https://console.groq.com/keys (no card).
GROQ_API_KEY=
# Optional EU fallback. In the Mistral console, turn off "Anonymous improvement data".
MISTRAL_API_KEY=
# OVHcloud AI Endpoints works without a key (2 requests/min per model); a token raises the limit.
OVH_AI_ENDPOINTS_TOKEN=

# Set in the process environment, not in this file:
#   DUMBLEDORE_DATA_DIR    data folder (default ~/Library/Application Support/Dumbledore); use a
#                          scratch folder for tests so your own data stays untouched
#   DUMBLEDORE_BUDGET_EUR  total AI spending cap in EUR (default 10); over it, paid routes are skipped
#   DUMBLEDORE_FAKES=1     fake engine and AI with demo data (no keys, no helper), for UI work
#   DUMBLEDORE_HELPER=external  connect to a helper already running on the dev socket instead
#                          of starting one (npm run dev starts it from the terminal)
#   DUMBLEDORE_CONTROL=1   local test-control channel (scripts drive the running app)
